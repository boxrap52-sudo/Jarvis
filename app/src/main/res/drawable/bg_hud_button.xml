<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#4000E5FF"/>
            <stroke android:width="2dp" android:color="@color/jarvis_cyan"/>
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#CC041424"/>
            <stroke android:width="2dp" android:color="@color/jarvis_cyan_dim"/>
        </shape>
    </item>
</selector>
