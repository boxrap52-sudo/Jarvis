<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/jarvis_background">

    <!-- Your hologram image: app/src/main/res/drawable/hologram.png -->
    <ImageView
        android:id="@+id/hologram"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:contentDescription="@string/hologram_description"
        android:scaleType="fitCenter"
        android:src="@drawable/hologram" />

    <!-- Moving scan line -->
    <View
        android:id="@+id/scan_line"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_gravity="top"
        android:alpha="0.6"
        android:background="@drawable/bg_scan_line"
        android:importantForAccessibility="no" />

    <!-- Top and bottom fades for readable text -->
    <View
        android:layout_width="match_parent"
        android:layout_height="170dp"
        android:layout_gravity="top"
        android:background="@drawable/bg_fade_top"
        android:importantForAccessibility="no" />
    <View
        android:layout_width="match_parent"
        android:layout_height="340dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_fade_bottom"
        android:importantForAccessibility="no" />

    <!-- Top header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="20dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/status_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_status_dot"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:letterSpacing="0.25"
                android:text="@string/system_online"
                android:textColor="@color/jarvis_cyan"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:letterSpacing="0.3"
            android:shadowColor="@color/jarvis_cyan"
            android:shadowRadius="18"
            android:text="@string/title_jarvis"
            android:textColor="@color/jarvis_cyan"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:letterSpacing="0.1"
            android:text="@string/welcome_sahil"
            android:textColor="@color/jarvis_text_dim"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Language switch -->
    <TextView
        android:id="@+id/btn_lang"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_pill"
        android:contentDescription="@string/btn_lang"
        android:minHeight="40dp"
        android:gravity="center"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:text="@string/lang_english"
        android:textColor="@color/jarvis_cyan"
        android:textSize="12sp" />

    <!-- Bottom controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingBottom="18dp">

        <TextView
            android:id="@+id/user_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:textColor="@color/jarvis_text_dim"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/reply_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="4"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:textColor="@color/jarvis_cyan"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/status_text"
            android:layout_marginTop="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.2"
            android:shadowColor="@color/jarvis_cyan"
            android:shadowRadius="10"
            android:text="@string/status_standby"
            android:textColor="@color/jarvis_cyan"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_camera"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/bg_hud_button"
                android:contentDescription="@string/btn_camera"
                android:padding="16dp"
                android:src="@drawable/ic_camera"
                android:tint="@color/jarvis_cyan" />

            <FrameLayout
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp">

                <View
                    android:id="@+id/mic_ring"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_pulse_ring"
                    android:importantForAccessibility="no" />

                <ImageButton
                    android:id="@+id/btn_mic"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_hud_button"
                    android:contentDescription="@string/btn_mic"
                    android:padding="22dp"
                    android:src="@drawable/ic_mic"
                    android:tint="@color/jarvis_cyan" />
            </FrameLayout>

            <ImageButton
                android:id="@+id/btn_command"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/bg_hud_button"
                android:contentDescription="@string/btn_command"
                android:padding="16dp"
                android:src="@drawable/ic_command"
                android:tint="@color/jarvis_cyan" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:letterSpacing="0.15"
            android:text="@string/credit_developer"
            android:textColor="@color/jarvis_text_dim"
            android:textSize="11sp" />
    </LinearLayout>

</FrameLayout>
